# MicroVM runtime state
.microvm
app.zip

# Proxy data (SQLite database — auto-created at runtime)
proxy/data/
!proxy/data/package_categories.json

# Completion catalog (generated at image build time from installed libs)
app/notebook/data/

# Tooling working dirs (local scan/agent artifacts — not source)
.ash/
.protoshield/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# modelcaps generator's LiteLLM download cache — a dev-time fetch artifact (~2MB),
# regenerated by modelcaps/refresh.py; never committed and never vendored into the
# service images (scripts/sync_modelcaps.sh copies only the runtime trio).
modelcaps/_litellm_models.json
# Dedicated venv for the product-spec PDF generator (scripts/generate_product_specs.py).
# Local tooling only.
scripts/.specgen-venv/
# Generated product-spec PDFs + .metadata.json sidecars + manifest.json for the
# Bedrock Knowledge Base. NOT committed: scripts/setup_bedrock_kb.sh generates them
# on first install (built-in template, --no-llm) when the folder is empty.
scripts/demoproductspec/
.env
*.egg-info/

# Node.js
web/node_modules/
web/dist/

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editor / IDE
.vscode/
.idea/
*.iml

# AWS credentials (should never be committed)
.aws/
credentials
*.pem

# Logs
*.log

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Auto-generated Aurora ARN handoff (written by scripts/setup_aurora_postgres.sh,
# sourced by local_install.sh). Machine-specific; never committed.
scripts/.aurora_env

# Auto-generated Bedrock KB handoff (written by scripts/setup_bedrock_kb.sh,
# sourced by local_install.sh). Machine-specific; never committed.
scripts/.kb_env

# Auto-generated SageMaker handoff (written by scripts/setup_sagemaker.sh,
# sourced by local_install.sh). Machine-specific; never committed.
scripts/.sagemaker_env

# Auto-generated NetworkEgressTest.py state handoff (written incrementally by
# tests/NetworkEgress/NetworkEgressTest.py, consumed by
# tests/NetworkEgress/NetworkEgressTeardown.py). Machine/run-specific; never committed.
tests/NetworkEgress/.network_egress_test_state.json
tests/NetworkEgress/.network_egress_test_state.json.lock
# Agent/workflow scratch output (investigation reports, review JSONs,
# plans, screenshots). Throwaway working artifacts; never committed.
.agents/
# Ruff lint cache
.ruff_cache/

# Git worktrees created by agent workflows
.worktrees/

# Threat model & security-review working docs (internal process artifacts:
# threat model, pre-publication review notes, remediation and rescan reports).
# These reference internal review processes and must NOT ship in the public
# aws-samples repo.
# Kept locally for the maintainer; untracked so they are not published.
threatmodel/

# Presentation decks (internal links, slides, third-party logos) — kept locally
# for the maintainer, not part of the public sample.
presentation/
