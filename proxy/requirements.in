# Data Catalog MODEL-ARTIFACT schema reads (S3SchemaProvider._schema_from_* — runs in
# the PROXY, not the VM). To show a saved model's input columns + classes in the panel:
#   • onnx           — lightweight protobuf/schema reader for a .onnx graph's inputs +
#                      class metadata (NOT onnxruntime; we only READ the graph, never
#                      run it). 1.23.1 has a prebuilt wheel for the proxy host's Python.
#   • scikit-learn   — to unpickle a saved sklearn model (.joblib) and read
#     + joblib         feature_names_in_/classes_, and to load a SageMaker job's sibling
#                      preprocessor.joblib (a fitted ColumnTransformer) for its feat_cols.
# Kept in lock-step with the VM's requirements.txt sklearn pin (1.9.1) so a model
# pickled in the VM unpickles cleanly here.
onnx==1.23.1
scikit-learn==1.9.1
joblib==1.4.2

# Inline notebook Format (runs proxy-side, NOT in the MicroVM). Format is a pure
# text transform that needs no kernel/VM, so it lives on the proxy: it works even
# when a notebook's VM is suspended/terminated, and it can be iterated with a proxy
# restart (no image rebuild). ruff formats Python cells; sqlglot pretty-prints SQL
# cells (duckdb dialect). NOTE: ruff + sqlglot ALSO remain in the MicroVM's
# requirements.txt — the VM still needs them for the LINT feature (which is
# namespace-aware and stays VM-side).
ruff>=0.16.0
sqlglot>=30.19.0

# Envelope encryption of notebook ENV VAR values at rest (proxy.platform.env_crypto).
# A master key in Secrets Manager (microvm-internal/env-master-key — outside the
# microvm/* prefix so the VM exec role can't read it) derives a per-notebook subkey
# (HKDF-SHA256, salt=notebook_id); each env var value is sealed with AES-256-GCM
# before it's written to notebook_env. Secret REFERENCES are unaffected (never held
# a value). Only the proxy holds the master key, so a DB reader sees ciphertext only.
cryptography>=43.0.0

# PostgreSQL driver — REQUIRED for the ECS/multi-task deploy. Locally the proxy
# runs on SQLite (STORAGE_BACKEND=sqlite, the default), but on ECS behind an ALB
# multiple proxy tasks must share ONE Aurora PostgreSQL store so the session
# registry, locks (pg_try_advisory_lock), and recovery state are consistent
# across tasks. proxy/storage/postgres_db.py imports psycopg2 lazily in
# initialize() and raises a RuntimeError if the driver is absent, so without this
# line the proxy cannot run with STORAGE_BACKEND=postgres at all. Same driver +
# pin as pool_manager/requirements.txt (both share proxy.storage). Harmless on the
# local SQLite path (imported only when the Postgres backend is selected).
psycopg2-binary>=2.9
