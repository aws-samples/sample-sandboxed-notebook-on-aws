# =============================================================================
# proxy/requirements.in — SOURCE for the hash-pinned host-side dependency lock
# =============================================================================
#
# This .in file is the human-edited SOURCE. The installable artifact is the
# GENERATED, fully hash-pinned lockfile proxy/requirements.txt — DO NOT hand-edit
# that file. local_install.sh installs it with `--require-hashes`, so every
# requirement (direct AND transitive) must be pinned to an exact version with
# sha256 hashes. The merged lock also covers pool_manager (its deps are a strict
# subset — see pool_manager/requirements.in).
#
# To regenerate the lock after editing this file (or pool_manager/requirements.in):
#
#   cd <repo root>
#   (cd agent/ai_assistant && uv export --no-emit-project --no-dev --format requirements-txt) > /tmp/h5-agent-constraints.txt
#   uv pip compile --generate-hashes -c /tmp/h5-agent-constraints.txt \
#       proxy/requirements.in pool_manager/requirements.in -o proxy/requirements.txt
#
# The agent export is passed as a constraint so the shared .venv (proxy + the
# ai_assistant agent leg install together) resolves to a jointly consistent set.
# =============================================================================

# Proxy server dependencies (runs on your machine, NOT inside the MicroVM)

# Web framework
fastapi>=0.139.0
uvicorn>=0.51.0

# OpenTelemetry floor — fastapi>=0.142 requires opentelemetry-api>=1.44.0, while
# strands-agents allows the wide range >=1.30,<2.0. Without an explicit floor the
# resolver can settle on the older 1.42.1 line (which some transitive pins still
# reference), tripping fastapi's requirement in the SHARED venv (proxy + the
# ai_assistant service install together). Pinning the floor here makes the merged
# install land on 1.44+ cleanly. (The container-only aws-opentelemetry-distro,
# which hard-pinned ==1.42.1, is isolated to ai_assistant's `tracing` group so it
# no longer drags the local venv down — see agent/ai_assistant/pyproject.toml.)
opentelemetry-api>=1.44.0
opentelemetry-sdk>=1.44.0

# HTTP client (for forwarding requests to MicroVMs)
